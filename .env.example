# Copia este archivo a .env y ajusta los valores para tu instalación.

# IP y puerto de la mesa Allen & Heath Qu-16 en la LAN.
QU16_MIXER_HOST=192.168.100.67
QU16_MIXER_PORT=51326

# El backend abre la conexión con la mesa al arrancar.
# Ponlo en "false" para que la API arranque en modo pasivo (sin tráfico).
QU16_AUTO_CONNECT=true

# Orígenes permitidos por CORS: lista separada por comas o JSON.
# QU16_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
